<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">Viagem #<%= @trip.id %></h1>
  <div>
    <%= link_to "Editar", edit_trip_path(@trip), class: "btn btn-outline-secondary" %>
    <%= link_to "Voltar", trips_path, class: "btn btn-link" %>
  </div>
</div>

<div class="card">
  <div class="card-body">
    <dl class="row mb-0">
      <dt class="col-sm-3">Veículo</dt>
      <dd class="col-sm-9"><%= @trip.vehicle.label %></dd>

      <dt class="col-sm-3">Motorista</dt>
      <dd class="col-sm-9"><%= @trip.driver.name %></dd>

      <dt class="col-sm-3">Início</dt>
      <dd class="col-sm-9"><%= format_datetime(@trip.started_at) %></dd>

      <dt class="col-sm-3">Fim</dt>
      <dd class="col-sm-9"><%= @trip.ended_at ? format_datetime(@trip.ended_at) : "—" %></dd>

      <dt class="col-sm-3">km rodados</dt>
      <dd class="col-sm-9"><%= format_km(@trip.distance_km) %> km</dd>

      <dt class="col-sm-3">Status</dt>
      <dd class="col-sm-9">
        <% if @trip.ongoing? %>
          <span class="badge text-bg-primary">Em andamento</span>
        <% else %>
          <span class="badge text-bg-success">Concluída</span>
        <% end %>
      </dd>
    </dl>
  </div>
</div>
