<h1 class="h3 mb-3 d-flex justify-content-between align-items-center">
  Viagens
  <%= link_to "Nova viagem", new_trip_path, class: "btn btn-primary" %>
</h1>

<div class="table-responsive">
  <table class="table table-striped table-hover align-middle">
    <thead>
      <tr>
        <th>Veículo</th>
        <th>Motorista</th>
        <th>Início</th>
        <th>Fim</th>
        <th>km rodados</th>
        <th>Status</th>
        <th class="text-end">Ações</th>
      </tr>
    </thead>
    <tbody>
      <%= render @trips %>
    </tbody>
  </table>
</div>
