<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">Veículo <%= @vehicle.plate %></h1>
  <div>
    <%= link_to "Editar", edit_vehicle_path(@vehicle), class: "btn btn-outline-secondary" %>
    <%= link_to "Voltar", vehicles_path, class: "btn btn-link" %>
  </div>
</div>

<div class="card">
  <div class="card-body">
    <dl class="row mb-0">
      <dt class="col-sm-3">Modelo</dt>
      <dd class="col-sm-9"><%= @vehicle.model %></dd>

      <dt class="col-sm-3">Placa</dt>
      <dd class="col-sm-9"><%= @vehicle.plate %></dd>

      <dt class="col-sm-3">Ano</dt>
      <dd class="col-sm-9"><%= @vehicle.year %></dd>

      <dt class="col-sm-3">Tipo</dt>
      <dd class="col-sm-9"><%= @vehicle.kind %></dd>

      <dt class="col-sm-3">Status</dt>
      <dd class="col-sm-9"><%= vehicle_status_badge(@vehicle.status) %></dd>

      <dt class="col-sm-3">Hodômetro</dt>
      <dd class="col-sm-9"><%= format_km(@vehicle.odometer) %> km</dd>

      <dt class="col-sm-3">Vencimento CRLV</dt>
      <dd class="col-sm-9"><%= format_date(@vehicle.crlv_expiration) %></dd>

      <dt class="col-sm-3">Vencimento Seguro</dt>
      <dd class="col-sm-9"><%= format_date(@vehicle.insurance_expiration) %></dd>

      <dt class="col-sm-3">Vencimento IPVA</dt>
      <dd class="col-sm-9"><%= format_date(@vehicle.ipva_expiration) %></dd>
    </dl>
  </div>
</div>
