<h1 class="h3 mb-3">Relatório de Manutenção</h1>

<%= form_with url: maintenance_report_path, method: :get, class: "row g-2 align-items-end mb-3" do |form| %>
  <div class="col-auto">
    <%= form.label :start_date, "De (abertura)", class: "form-label" %>
    <%= form.date_field :start_date, value: params[:start_date], class: "form-control" %>
  </div>
  <div class="col-auto">
    <%= form.label :end_date, "Até (abertura)", class: "form-label" %>
    <%= form.date_field :end_date, value: params[:end_date], class: "form-control" %>
  </div>
  <div class="col-auto">
    <%= form.label :q, "Veículo/Placa", class: "form-label" %>
    <%= form.text_field :q, value: params[:q], class: "form-control" %>
  </div>
  <div class="col-auto">
    <%= form.label :status, "Situação", class: "form-label" %>
    <%= form.select :status, [["Todas", ""]] + maintenance_status_options, { selected: params[:status] }, class: "form-select" %>
  </div>
  <div class="col-auto">
    <%= form.submit "Filtrar", class: "btn btn-primary" %>
    <%= link_to "Limpar", maintenance_report_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>

<div class="d-flex justify-content-between align-items-center mb-2">
  <span class="text-muted"><%= @pagy.count %> registro(s)</span>
  <%= link_to "Exportar CSV", maintenance_report_path(request.query_parameters.merge(format: :csv)), class: "btn btn-success btn-sm" %>
</div>

<div class="table-responsive">
  <table class="table table-striped table-hover align-middle">
    <thead>
      <tr>
        <th><%= report_sort_link("opened_at", "Data de Abertura") %></th>
        <th><%= report_sort_link("scheduled_for", "Data Agendada") %></th>
        <th><%= report_sort_link("vehicle", "Veículo") %></th>
        <th><%= report_sort_link("plate", "Placa") %></th>
        <th><%= report_sort_link("odometer", "km") %></th>
        <th><%= report_sort_link("released_at", "Data de Saída") %></th>
        <th><%= report_sort_link("description", "O que foi feito") %></th>
      </tr>
    </thead>
    <tbody>
      <% @orders.each do |order| %>
        <tr>
          <td><%= format_date(order.opened_at) %></td>
          <td><%= format_date(order.scheduled_for) %></td>
          <td><%= order.vehicle.model %></td>
          <td><%= order.vehicle.plate %></td>
          <td><%= format_km(order.odometer) %></td>
          <td><%= order.released_at ? format_date(order.released_at) : "Em andamento" %></td>
          <td><%= order.description.presence || "—" %></td>
        </tr>
      <% end %>
      <% if @orders.empty? %>
        <tr>
          <td colspan="7" class="text-center text-muted py-3">Nenhuma ordem de serviço encontrada.</td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<%== pagy_bootstrap_nav(@pagy) if @pagy.pages > 1 %>
