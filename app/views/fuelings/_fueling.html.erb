<tr>
  <td><%= format_date(fueling.date) %></td>
  <td><%= fueling.vehicle.label %></td>
  <td><%= format_decimal(fueling.liters) %> L</td>
  <td><%= format_currency(fueling.cost) %></td>
  <td><%= format_km(fueling.odometer) %> km</td>
  <td><%= format_decimal(fueling.consumption_km_l) %></td>
  <td>R$ <%= format_decimal(fueling.cost_per_km, precision: 3) %></td>
  <td class="text-end">
    <%= link_to "Ver", fueling, class: "btn btn-sm btn-outline-secondary" %>
    <%= link_to "Editar", edit_fueling_path(fueling), class: "btn btn-sm btn-outline-secondary" %>
    <%= link_to "Excluir", fueling, data: { turbo_method: :delete, turbo_confirm: "Excluir este abastecimento?" }, class: "btn btn-sm btn-outline-danger" %>
  </td>
</tr>
