<h1 class="h3 mb-3 d-flex justify-content-between align-items-center">
  Manutenção (ordens de serviço)
  <%= link_to "Nova ordem de serviço", new_maintenance_order_path, class: "btn btn-primary" %>
</h1>

<div class="table-responsive">
  <table class="table table-striped table-hover align-middle">
    <thead>
      <tr>
        <th>Veículo</th>
        <th>Placa</th>
        <th>Tipo</th>
        <th>Situação</th>
        <th>Abertura</th>
        <th>Agendada</th>
        <th>km</th>
        <th>Saída</th>
        <th class="text-end">Ações</th>
      </tr>
    </thead>
    <tbody>
      <%= render @maintenance_orders %>
    </tbody>
  </table>
</div>
