<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">Ordem de serviço #<%= @maintenance_order.id %></h1>
  <div>
    <%= link_to "Editar", edit_maintenance_order_path(@maintenance_order), class: "btn btn-outline-secondary" %>
    <%= link_to "Voltar", maintenance_orders_path, class: "btn btn-link" %>
  </div>
</div>

<div class="card">
  <div class="card-body">
    <dl class="row mb-0">
      <dt class="col-sm-3">Veículo</dt>
      <dd class="col-sm-9"><%= @maintenance_order.vehicle.label %></dd>

      <dt class="col-sm-3">Tipo</dt>
      <dd class="col-sm-9"><%= maintenance_kind_label(@maintenance_order.kind) %></dd>

      <dt class="col-sm-3">Situação</dt>
      <dd class="col-sm-9"><%= maintenance_status_badge(@maintenance_order.status) %></dd>

      <dt class="col-sm-3">Data de abertura</dt>
      <dd class="col-sm-9"><%= format_date(@maintenance_order.opened_at) %></dd>

      <dt class="col-sm-3">Data agendada</dt>
      <dd class="col-sm-9"><%= format_date(@maintenance_order.scheduled_for) %></dd>

      <dt class="col-sm-3">km</dt>
      <dd class="col-sm-9"><%= format_km(@maintenance_order.odometer) %> km</dd>

      <dt class="col-sm-3">Data de saída</dt>
      <dd class="col-sm-9"><%= @maintenance_order.released_at ? format_date(@maintenance_order.released_at) : "Em andamento" %></dd>

      <dt class="col-sm-3">O que foi feito</dt>
      <dd class="col-sm-9"><%= @maintenance_order.description.presence || "—" %></dd>
    </dl>
  </div>
</div>
